<mxfile host="app.diagrams.net">
  <diagram id="crisp" name="CRISP pipeline">
    <mxGraphModel dx="1200" dy="400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="260" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== Group 1: text-variant augmentation ===== -->
        <mxCell id="g1" value="&lt;b&gt;① In-situ slot proposal &amp;amp; catalog grounding&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#EEF4FB;strokeColor=#4A78B5;verticalAlign=top;align=center;fontFamily=Times New Roman;fontSize=13;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="20" width="430" height="170" as="geometry"/>
        </mxCell>
        <!-- ===== Group 2: respelling ===== -->
        <mxCell id="g2" value="&lt;b&gt;② Respelling&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#FDF1E6;strokeColor=#C9772E;verticalAlign=top;align=center;fontFamily=Times New Roman;fontSize=13;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="625" y="20" width="150" height="170" as="geometry"/>
        </mxCell>

        <!-- Source -->
        <mxCell id="src" value="Monolingual&lt;br&gt;transcript &lt;i&gt;T&lt;/i&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(+ source audio)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="20" y="65" width="125" height="65" as="geometry"/>
        </mxCell>

        <!-- Slot proposal -->
        <mxCell id="slot" value="Slot proposal&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LLM: where to switch&lt;br&gt;(Rep / Ins, no English word)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="185" y="65" width="125" height="65" as="geometry"/>
        </mxCell>
        <!-- Grounding -->
        <mxCell id="ground" value="Catalog grounding&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cos(φ(p), φ(c)) ≥ τ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A78B5;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="65" width="120" height="65" as="geometry"/>
        </mxCell>
        <!-- Variant expansion -->
        <mxCell id="fill" value="Variant set&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;𝒱(T): e ∈ 𝒱&lt;sub&gt;ĉ&lt;/sub&gt;&lt;/font&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#FFFFFF;strokeColor=#4A78B5;fontFamily=Times New Roman;fontSize=13;size=0.15;" vertex="1" parent="1">
          <mxGeometry x="470" y="62" width="115" height="70" as="geometry"/>
        </mxCell>
        <!-- Catalog -->
        <mxCell id="cat" value="Entity catalog ℰ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=6;fillColor=#DCE8F5;strokeColor=#4A78B5;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="335" y="143" width="110" height="38" as="geometry"/>
        </mxCell>

        <!-- Respelling -->
        <mxCell id="resp" value="Sample spelling&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;canonical w.p. 1−ρ&lt;br&gt;respelled w.p. ρ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9772E;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="640" y="65" width="120" height="65" as="geometry"/>
        </mxCell>

        <!-- TTS + filter -->
        <mxCell id="tts" value="Full-utterance TTS&lt;br&gt;+ ASR filter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#333333;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="800" y="65" width="115" height="65" as="geometry"/>
        </mxCell>
        <!-- Output -->
        <mxCell id="out" value="&lt;b&gt;Synthetic CS&lt;br&gt;corpus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(x̃, y)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=2;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="940" y="65" width="100" height="65" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="src" target="slot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="endArrow=block;endFill=1;html=1;strokeColor=#4A78B5;" edge="1" parent="1" source="slot" target="ground"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="endArrow=block;endFill=1;html=1;strokeColor=#4A78B5;" edge="1" parent="1" source="ground" target="fill"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#4A78B5;" edge="1" parent="1" source="cat" target="ground"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="fill" target="resp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="z" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;fontFamily=Times New Roman;fontStyle=2;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="resp" target="tts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" style="endArrow=block;endFill=1;html=1;strokeColor=#333333;" edge="1" parent="1" source="tts" target="out"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- label y bypasses respelling -->
        <mxCell id="e8" value="label y (canonical)" style="endArrow=block;endFill=1;html=1;dashed=1;strokeColor=#888888;fontFamily=Times New Roman;fontSize=11;fontStyle=2;edgeStyle=orthogonalEdgeStyle;rounded=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="fill" target="out">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="527" y="8"/><mxPoint x="990" y="8"/></Array></mxGeometry>
        </mxCell>

        <!-- One-line running example -->
        <mxCell id="ex" value="&lt;i&gt;ờ khởi động lại cái &lt;b&gt;máy chủ&lt;/b&gt; này giúp mình nhé&lt;/i&gt;  →  &lt;i&gt;… cái &lt;b&gt;&lt;font color=&quot;#4A78B5&quot;&gt;server&lt;/font&gt;&lt;/b&gt; này …&lt;/i&gt;  →  &lt;i&gt;… cái &lt;b&gt;&lt;font color=&quot;#C9772E&quot;&gt;sơ-vơ&lt;/font&gt;&lt;/b&gt; này …&lt;/i&gt;" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="170" y="198" width="605" height="24" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
